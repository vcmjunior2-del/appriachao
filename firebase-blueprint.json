{
  "entities": {
    "TFDAppointment": {
      "title": "TFD Appointment",
      "description": "A request for Tratamento Fora de Domicílio transportation.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The ID of the user who requested the transport." },
        "userName": { "type": "string", "description": "The name of the user who requested the transport." },
        "patientName": { "type": "string", "description": "The name of the patient." },
        "patientCpf": { "type": "string", "description": "The CPF of the patient." },
        "appointmentDate": { "type": "string", "format": "date-time", "description": "The date and time of the medical appointment." },
        "transportDate": { "type": "string", "format": "date-time", "description": "The requested date and time for transport." },
        "destinationCity": { "type": "string", "description": "The destination city." },
        "destinationHospital": { "type": "string", "description": "The destination hospital or clinic." },
        "medicalSpecialty": { "type": "string", "description": "The medical specialty of the appointment." },
        "hasAccompanyingPerson": { "type": "boolean", "description": "Whether the patient has an accompanying person." },
        "accompanyingPersonName": { "type": "string", "description": "The name of the accompanying person, if any." },
        "contactPhone": { "type": "string", "description": "The contact phone number." },
        "status": { "type": "string", "enum": ["Pendente", "Confirmado", "Cancelado", "Realizado"], "description": "The current status of the request." },
        "createdAt": { "type": "string", "format": "date-time", "description": "The timestamp when the request was created." },
        "notes": { "type": "string", "description": "Optional notes for the request." }
      },
      "required": ["userId", "patientName", "patientCpf", "appointmentDate", "transportDate", "destinationCity", "destinationHospital", "contactPhone", "status", "createdAt"]
    },
    "RecyclingProfile": {
      "title": "Recycling Profile",
      "description": "Links a citizen user to their property code and tracks accumulated EcoPontos and bags.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "propertyCode": { "type": "string" },
        "ecoPoints": { "type": "integer" },
        "totalBags": { "type": "integer" },
        "linkedAt": { "type": "string", "format": "date-time" },
        "neighborhood": { "type": "string" }
      },
      "required": ["userId", "userName", "propertyCode", "ecoPoints", "totalBags"]
    },
    "RecyclingTransaction": {
      "title": "Recycling Transaction",
      "description": "A validated recycling bag collection log recorded by an agent.",
      "type": "object",
      "properties": {
        "agentId": { "type": "string" },
        "agentName": { "type": "string" },
        "citizenId": { "type": "string" },
        "citizenName": { "type": "string" },
        "citizenCpf": { "type": "string" },
        "citizenImovel": { "type": "string" },
        "sacosVolume": { "type": "integer" },
        "pontos": { "type": "integer" },
        "gps": { "type": "object" },
        "status": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["agentId", "citizenId", "sacosVolume", "pontos", "status"]
    },
    "BulkPickupRequest": {
      "title": "Bulk Pickup Request",
      "description": "A scheduled request for collecting heavy items like prunings or furniture.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string" },
        "address": { "type": "string" },
        "dateTime": { "type": "string" },
        "description": { "type": "string" },
        "status": { "type": "string" }
      },
      "required": ["userId", "type", "address", "dateTime", "status"]
    }
  },
  "firestore": {
    "/tfd_appointments/{appointmentId}": {
      "schema": "TFDAppointment",
      "description": "Collection of TFD transportation requests."
    },
    "/recycling_profiles/{profileId}": {
      "schema": "RecyclingProfile",
      "description": "User registration for IPTU Verde."
    },
    "/recycling_transactions/{transactionId}": {
      "schema": "RecyclingTransaction",
      "description": "Logged recycling deposits."
    },
    "/recycling_bulk_pickups/{pickupId}": {
      "schema": "BulkPickupRequest",
      "description": "Bulky item collection appointments."
    }
  }
}
