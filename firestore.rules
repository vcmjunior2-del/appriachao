
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Funções Auxiliares ---
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
             (request.auth.token.get('anonymous', false) == true || 
              request.auth.token.firebase.sign_in_provider == 'anonymous' || 
              request.auth.token.get('email', '') == 'administracao@riachaodojacuipe.ba.gov.br');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // --- Configurações (Leitura Pública) ---
    // Usando wildcard recursivo para garantir acesso a qualquer documento/subcoleção
    
    match /app_config/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /secretariats/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /service_types/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /info_services/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /occurrence_subjects/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /improvement_areas/{document=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /city_places/{placeId} {
      allow read: if true; 
      allow write: if isAuthenticated();
    }

    match /city_place_subcategories/{subCatId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
    
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // --- Frota / GPS (CORREÇÃO DE PERMISSÃO) ---
    match /garbage_trucks/{truckId} {
      allow read: if true; // Qualquer um pode ver no mapa
      // Permitimos 'isAuthenticated' ao invés de apenas 'isAdmin' para que o login "admin/admin" (Anônimo) funcione na demonstração.
      allow write: if isAuthenticated(); 
    }

    // --- Dados de Usuário ---

    match /users/{userId} {
      // Admin lê tudo. Dono lê o seu.
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
    }

    // --- Solicitações (Requests) ---

    match /requests/{requestId} {
      allow create: if isAuthenticated();
      
      allow read: if isAuthenticated();
      
      allow update: if isAuthenticated();
      
      allow delete: if isAuthenticated();
    }

    // --- Notificações ---

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isAuthenticated() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all'));
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // --- Sentimento ---

    match /sentiment_logs/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow write: if isAdmin() || isOwner(userId);
    }
    
    // Regra Padrão de Bloqueio (Segurança)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
