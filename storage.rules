
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Mesma regra de admin do firestore.rules: e-mail institucional verificado.
    function isAdmin() {
      return request.auth != null &&
             request.auth.token.get('email_verified', false) == true &&
             request.auth.token.get('email', '') in [
               'administracao@riachaodojacuipe.ba.gov.br'
             ];
    }

    // Cidadão só envia imagens de até 10 MB
    function isSmallImage() {
      return request.resource.size < 10 * 1024 * 1024 &&
             request.resource.contentType.matches('image/.*');
    }

    // Pasta de evidências (fotos de ocorrências)
    match /evidence/{userId}/{allPaths=**} {
      allow read: if true; 
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && isSmallImage());
    }

    // Pasta de fotos de perfil
    match /profile_photos/{userId} {
      allow read: if true;
      allow write: if isAdmin() || (request.auth != null && request.auth.uid == userId && isSmallImage());
    }

    // Conteúdo gerenciado pelo painel (upload só admin, leitura pública)
    match /service_icons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /subject_icons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /city_places/{allPaths=**} {
      allow read: if true; 
      allow write: if isAdmin(); 
    }

    match /city_place_icons/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /logos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /news_images/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /news_videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Bloqueio padrão
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
